# 브라우저 헤드리스 실행 여부 (npm run login 은 항상 headed로 동작합니다)
HEADLESS=true

# npm run login 으로 생성되는 로그인 세션 파일 경로 (절대 git에 커밋하지 마세요)
AUTH_STATE_PATH=.auth/openai-storage-state.json

# 생성된 이미지/영상을 저장할 폴더
OUTPUT_DIR=./output

# ChatGPT / Sora 기본 URL (UI 개편 시 여기만 바꾸면 됩니다)
CHATGPT_URL=https://chatgpt.com
SORA_URL=https://sora.chatgpt.com

# 네이버 뉴스 검색 API를 쓰고 싶을 때만 채우세요 (선택 사항).
# 비워두면 별도 키 없이 구글 뉴스 RSS(한국)로 인기 뉴스를 조사합니다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 하루에 처리할 뉴스 주제 개수
TOPIC_COUNT=1
